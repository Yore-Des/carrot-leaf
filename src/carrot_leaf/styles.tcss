/* Layout: logo + URL bar on top, then sections split by labelled rules on a 2-column gutter. */

Screen {
    background: $background;
}

/* ---------- header ---------- */

#logo {
    width: 100%;
    height: auto;
    padding: 1 2 0 2;
    text-align: center;
}

MainScreen.-short #logo {
    display: none;
}

#status-line {
    height: 1;
    margin: 1 2 0 2;
    color: $text-muted;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#url-row {
    height: auto;
    margin: 1 2 0 2;
    border: solid $primary 50%;
    border-title-color: $primary;
    border-title-style: bold;
}

#url-row:focus-within {
    border: solid $primary;
}

#prompt {
    width: 2;
    padding-left: 1;
    color: $primary;
    text-style: bold;
}

#url {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0 1;
    background: $background;
}

#url:focus {
    border: none;
}

Input:focus {
    background-tint: $foreground 0%;
}

/* ---------- section rules ---------- */

VideoCard, DownloadQueue {
    margin: 1 2 0 2;
    padding: 1 0 0 0;
    border: none;
    border-top: solid $panel;
    border-title-align: left;
    border-title-style: bold;
    background: $background;
}

/* ---------- video card ---------- */

VideoCard {
    height: auto;
    border-title-color: $primary;
}

#card-switcher {
    height: auto;
}

#card-empty {
    height: auto;
    color: $text-muted;
}

#card-loading {
    height: 1;
}

#card-loading LoadingIndicator {
    width: 8;
    height: 1;
    color: $primary;
}

#loading-text {
    width: auto;
    color: $text-muted;
}

#card-error {
    height: auto;
}

#error-hint {
    margin: 1 0;
    color: $text-muted;
}

#card-info {
    height: auto;
}

#thumb {
    margin-right: 3;
}

#details {
    height: auto;
    width: 1fr;
}

#video-title {
    color: $text;
    text-style: bold;
    margin-bottom: 1;
}

#video-meta {
    margin-bottom: 1;
}

#action-hint {
    width: auto;
    color: $text-muted;
}

/* ---------- buttons: plain text, a solid chip when focused ---------- */

Button, Button.-primary, Button.-success, Button.-default {
    width: auto;
    min-width: 0;
    height: 1;
    padding: 0 1;
    border: none;
    background: $background;
    color: $primary;
    text-style: bold;
}

Button:hover, Button.-primary:hover, Button.-success:hover, Button.-default:hover {
    background: $panel;
    border: none;
}

Button:focus, Button.-primary:focus, Button.-success:focus, Button.-default:focus {
    background: $primary;
    color: $background;
    text-style: bold;
}

Button.-active {
    background: $primary-darken-1;
    border: none;
}

#cancel {
    color: $text-muted;
}

#cancel:focus {
    background: $foreground-muted;
    color: $background;
}

#error-actions, #actions, #dialog-actions {
    height: auto;
}

#error-actions Button, #actions Button, #dialog-actions Button {
    margin-right: 2;
}


#actions Button {
    margin-right: 2;
}

/* ---------- download list ---------- */

DownloadQueue {
    height: 1fr;
    min-height: 5;
    border-title-color: $text-muted;
    scrollbar-size-vertical: 1;
}

#queue-empty {
    color: $text-muted;
}

JobRow {
    padding: 0 0 1 0;
}

.job-head {
    height: 1;
}

.job-mark {
    width: 2;
    color: $text-muted;
    text-style: bold;
}

JobRow.-running .job-mark {
    color: $primary;
}

JobRow.-done .job-mark {
    color: $success;
}

JobRow.-failed .job-mark {
    color: $error;
}

.job-title {
    width: 1fr;
    text-style: bold;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.job-kind {
    width: auto;
    color: $primary;
    margin-left: 2;
}

.job-body {
    height: 1;
    padding-left: 2;
}

JobRow ProgressBar {
    width: 32;
}

JobRow Bar {
    width: 30;
}

JobRow Bar > .bar--bar {
    color: $primary;
    background: $panel;
}

JobRow Bar > .bar--indeterminate {
    color: $accent;
    background: $panel;
}

JobRow.-done Bar > .bar--complete,
JobRow.-done Bar > .bar--bar {
    color: $success;
}

JobRow.-failed Bar > .bar--bar {
    color: $error;
}

.job-status {
    width: 1fr;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* ---------- footer ---------- */

Footer {
    height: 2;
    padding: 0 2;
    border-top: solid $panel;
    background: $background;
}

FooterKey {
    background: $background;
}

FooterKey .footer-key--key {
    color: $primary;
    background: $background;
}

FooterKey .footer-key--description {
    color: $text-muted;
    background: $background;
}

/* ---------- dialogs ---------- */

ModalScreen {
    align: center middle;
    background: $background 70%;
}

#dialog {
    width: 76;
    max-width: 95%;
    height: auto;
    max-height: 95%;
    padding: 1 2;
    border: solid $primary;
    background: $background;
}

#dialog.cookies {
    width: 60;
}

#dialog-title {
    margin-bottom: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#dialog-actions {
    margin-top: 1;
}

#kind {
    height: auto;
}

.pickers {
    height: auto;
    padding-top: 1;
}

.picker {
    width: 1fr;
    height: auto;
}

.picker:first-of-type {
    margin-right: 2;
}

.picker-label, .field-label {
    color: $text-muted;
    margin-bottom: 0;
}

.field-label {
    margin-top: 1;
}

.picker OptionList {
    height: 10;
}

#summary {
    margin: 1 0 0 0;
}

#folder-row {
    height: auto;
}

#folder {
    width: 1fr;
    border: solid $panel;
    background: $background;
}

#folder:focus {
    border: solid $primary;
}

#browse {
    margin: 1 0 0 1;
}

#tree {
    height: 12;
    border: solid $panel;
    background: $background;
}

#folder-error {
    height: auto;
}

#cookies {
    width: 40;
}

#cookies-note {
    margin: 1 0;
}

#browsers {
    height: auto;
    max-height: 10;
    margin: 1 0;
    border: solid $panel;
    background: $background;
}

/* ---------- lists, tabs, selects: grey at rest, one solid accent chip on focus ---------- */

OptionList {
    border: solid $panel;
    background: $background;
    scrollbar-size-vertical: 1;
    scrollbar-background: $background;
    scrollbar-background-hover: $background;
    scrollbar-background-active: $background;
    scrollbar-color: $panel;
    scrollbar-color-hover: $primary;
    scrollbar-color-active: $primary;
    scrollbar-corner-color: $background;
}

OptionList:focus {
    border: solid $primary;
    background-tint: $foreground 0%;
}

OptionList > .option-list--option-highlighted {
    color: $foreground;
    background: $panel;
    text-style: bold;
}

OptionList:focus > .option-list--option-highlighted {
    color: $background;
    background: $primary;
    text-style: bold;
}

OptionList > .option-list--option-hover {
    background: $panel;
}

Tabs Tab {
    color: $text-muted;
    background: $background;
}

Tabs Tab.-active {
    color: $primary;
    text-style: bold;
}

Tabs:focus Tab.-active {
    color: $background;
    background: $primary;
}

Tabs Underline > .underline--bar {
    color: $primary;
    background: $panel;
}

Select > SelectCurrent {
    border: solid $panel;
    background: $background;
}

Select:focus > SelectCurrent {
    border: solid $primary;
    background-tint: $foreground 0%;
}

Select > SelectOverlay {
    border: solid $primary;
}

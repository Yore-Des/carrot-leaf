/* Layout: logo + URL bar on top, then sections split by labelled rules on a 2-column gutter. */

Screen {
    background: $background;
}

/* ---------- header ---------- */

#logo {
    width: 100%;
    height: auto;
    padding: 1 2 0 2;
    text-align: center;
}

MainScreen.-short #logo {
    display: none;
}

#status-line {
    height: 1;
    margin: 1 2 0 2;
    color: $text-muted;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* ---------- tabs ---------- */

#tabs {
    height: 1;
    margin: 1 2 0 2;
    link-style: none;
    link-color: $text-muted;
    link-background: $background;
    link-style-hover: bold;
    link-color-hover: $primary;
    link-background-hover: $panel;
}

#panes, #pane-download, FilesPane {
    height: 1fr;
}

.source-row {
    height: auto;
    margin: 1 2 0 2;
    border: solid $primary 50%;
    border-title-color: $primary;
    border-title-style: bold;
}

.source-row:focus-within {
    border: solid $primary;
}

.prompt {
    width: 2;
    padding-left: 1;
    color: $primary;
    text-style: bold;
}

#url, #file-input {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0 1;
    background: $background;
}

#url:focus, #file-input:focus {
    border: none;
}

Input:focus {
    background-tint: $foreground 0%;
}

/* ---------- section rules ---------- */

VideoCard, DownloadQueue, #files-card {
    margin: 1 2 0 2;
    padding: 1 0 0 0;
    border: none;
    border-top: solid $panel;
    border-title-align: left;
    border-title-style: bold;
    background: $background;
}

/* ---------- video card ---------- */

VideoCard {
    height: auto;
    border-title-color: $primary;
}

#files-card {
    height: auto;
    max-height: 50%;
    border-title-color: $primary;
}

#files-empty, #files-status {
    height: auto;
    color: $text-muted;
}

#files {
    height: auto;
    max-height: 12;
    border: none;
    padding: 0;
    background: $background;
    margin-bottom: 1;
}

#files:focus {
    border: none;
    background-tint: $foreground 0%;
}

#files-hint {
    width: auto;
    color: $text-muted;
}

#card-switcher {
    height: auto;
}

#card-empty {
    height: auto;
    color: $text-muted;
}

#card-loading {
    height: 1;
}

#card-loading LoadingIndicator {
    width: 8;
    height: 1;
    color: $primary;
}

#loading-text {
    width: auto;
    color: $text-muted;
}

#card-error {
    height: auto;
}

#error-hint {
    margin: 1 0;
    color: $text-muted;
}

#card-info {
    height: auto;
}

#thumb {
    margin-right: 3;
}

#details {
    height: auto;
    width: 1fr;
}

#video-title {
    color: $text;
    text-style: bold;
    margin-bottom: 1;
}

#video-meta {
    margin-bottom: 1;
}

#action-hint {
    width: auto;
    color: $text-muted;
}

/* ---------- buttons: plain text, a solid chip when focused ---------- */

Button, Button.-primary, Button.-success, Button.-default {
    width: auto;
    min-width: 0;
    height: 1;
    padding: 0 1;
    border: none;
    background: $background;
    color: $primary;
    text-style: bold;
}

Button:hover, Button.-primary:hover, Button.-success:hover, Button.-default:hover {
    background: $panel;
    border: none;
}

Button:focus, Button.-primary:focus, Button.-success:focus, Button.-default:focus {
    background: $primary;
    color: $background;
    text-style: bold;
}

Button.-active {
    background: $primary-darken-1;
    border: none;
}

#cancel {
    color: $text-muted;
}

#cancel:focus {
    background: $foreground-muted;
    color: $background;
}

#error-actions, #actions, #dialog-actions, #files-actions {
    height: auto;
}

#error-actions Button, #actions Button, #dialog-actions Button, #files-actions Button {
    margin-right: 2;
}


#actions Button {
    margin-right: 2;
}

/* ---------- download list ---------- */

DownloadQueue {
    height: 1fr;
    min-height: 5;
    border-title-color: $text-muted;
    scrollbar-size-vertical: 1;
}

.queue-empty {
    color: $text-muted;
}

JobRow {
    padding: 0 0 1 0;
}

.job-head {
    height: 1;
}

.job-mark {
    width: 2;
    color: $text-muted;
    text-style: bold;
}

JobRow.-running .job-mark {
    color: $primary;
}

JobRow.-done .job-mark {
    color: $success;
}

JobRow.-failed .job-mark {
    color: $error;
}

.job-title {
    width: 1fr;
    text-style: bold;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.job-kind {
    width: auto;
    color: $primary;
    margin-left: 2;
}

.job-cancel {
    margin-left: 2;
    color: $text-muted;
}

JobRow .job-cancel:focus {
    background: $error;
    color: $background;
}

.job-body {
    height: 1;
    padding-left: 2;
}

JobRow BlockBar {
    width: 30;
    color: $primary;
}

JobRow BlockBar > .block-bar--track {
    color: $panel;
}

JobRow.-done BlockBar {
    color: $success;
}

JobRow.-failed BlockBar, JobRow.-cancelled BlockBar {
    color: $panel;
}

.job-status {
    margin-left: 2;
    width: 1fr;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* ---------- key bar ---------- */

#keys {
    dock: bottom;
    text-align: center;
    height: 2;
    padding: 0 2;
    border-top: solid $panel;
    background: $background;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    link-style: none;
    link-color: $text-muted;
    link-background: $background;
    link-style-hover: bold;
    link-color-hover: $primary;
    link-background-hover: $panel;
}

/* ---------- dialogs ----------
   One look for every popup, after gingertea: a rounded accent frame, sections in rounded
   titled panels, one-row filled fields, and big equal-width buttons at the bottom. */

ModalScreen {
    align: center middle;
    background: $background 70%;
}

#dialog {
    width: 76;
    max-width: 95%;
    height: auto;
    max-height: 95%;
    padding: 1 2;
    overflow-y: auto;
    border: round $primary;
    background: $background;
    scrollbar-size-vertical: 1;
}

#dialog.convert { width: 92; }
#dialog.cookies { width: 60; }
#dialog.sites { width: 64; height: 30; }
#dialog.picker-dialog { width: 80; height: 32; }
#dialog.playlist, #dialog.history, #dialog.following { width: 92; height: 34; }
#dialog.search { width: 110; height: 40; }
#dialog.clip-picker { width: 84; }
#dialog.preset-save { width: 60; }

#dialog-title {
    margin-bottom: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#summary {
    height: auto;
    margin-top: 1;
}

/* ---------- panels: rounded, titled in the border, lit up while you're inside ---------- */

.panel {
    width: 1fr;
    border: round $panel;
    border-title-color: $text-muted;
    border-title-style: bold;
    border-title-align: left;
    padding: 0 1;
    background: $background;
}

.panel:focus-within {
    border: round $primary;
    border-title-color: $primary;
}

.panel-row {
    height: auto;
}

.panel-row .panel:first-of-type {
    margin-right: 2;
}

.panel-row.top { height: 11; margin-top: 1; }
.panel-row.bottom { height: 9; margin-top: 1; }

#dialog .panel OptionList, #dialog .panel OptionList:focus {
    height: 1fr;
    border: none;
    padding: 0;
    background: $background;
    background-tint: $foreground 0%;
}

/* ---------- buttons ---------- */

/* Small buttons inside a dialog: a filled one-row chip, never a border. */
#dialog Button {
    height: 1;
    min-width: 0;
    padding: 0 2;
    border: none;
    background: $panel;
    color: $foreground;
    text-style: none;
}

#dialog Button:hover {
    background: $primary 40%;
    border: none;
}

#dialog Button:focus {
    background: $primary;
    color: $background;
    text-style: bold;
    border: none;
}

#dialog Button.-active {
    background: $primary-darken-1;
    border: none;
}

/* The dialog's own actions: equal halves, three rows tall. Both are solid blocks whose
   border matches their fill, so no lines show and both stand exactly as tall: an outline
   would draw its edge mid-row and look shorter. Accent for the main one, grey for the other. */
#dialog-actions {
    height: 3;
    margin-top: 1;
}

#dialog #dialog-actions Button {
    width: 1fr;
    height: 3;
    margin: 0;
    padding: 0 2;
    content-align: center middle;
    text-style: bold;
    border: round $panel;
    background: $panel;
    color: $foreground;
}

#dialog #dialog-actions Button:first-of-type {
    margin-right: 2;
}

#dialog #dialog-actions Button:hover {
    border: round $panel-lighten-1;
    background: $panel-lighten-1;
}

#dialog #dialog-actions Button:focus {
    border: round $panel-lighten-2;
    background: $panel-lighten-2;
}

#dialog #dialog-actions Button.-primary {
    border: round $primary;
    background: $primary;
    color: $background;
}

#dialog #dialog-actions Button.-primary:hover {
    border: round $primary-lighten-1;
    background: $primary-lighten-1;
}

#dialog #dialog-actions Button.-primary:focus {
    border: round $primary-lighten-2;
    background: $primary-lighten-2;
}

#dialog #dialog-actions Button.-active {
    border: round $primary-darken-1;
    background: $primary-darken-1;
    color: $background;
}

#dialog #dialog-actions #cancel:hover, #dialog #dialog-actions #cancel:focus {
    border: round $error 70%;
    background: $error 70%;
    color: $background;
}

/* ---------- fields: one filled row, a warmer fill while typing ---------- */

#dialog Input {
    height: 1;
    min-height: 1;
    border: none;
    padding: 0 1;
    background: $panel;
}

#dialog Input:focus {
    border: none;
    background: $primary 25%;
}

#dialog Input:disabled {
    background: $panel 40%;
    color: $text-disabled;
}

Input > .input--placeholder {
    color: $text-muted;
    text-style: italic;
}

#dialog Select {
    height: 1;
    min-height: 1;
}

#dialog Select > SelectCurrent, #dialog Select:focus > SelectCurrent {
    height: 1;
    border: none;
    padding: 0 1;
    background: $panel;
}

#dialog Select:focus > SelectCurrent {
    background: $primary 25%;
}

/* Lists that are a dialog's main content get the same rounded frame as the panels. */
#dialog OptionList, #dialog SelectionList, #dialog DirectoryTree {
    border: round $panel;
    background: $background;
}

#dialog OptionList:focus, #dialog SelectionList:focus, #dialog DirectoryTree:focus {
    border: round $primary;
    background-tint: $foreground 0%;
}

/* ---------- convert ---------- */

#kind {
    height: auto;
}

#presets {
    height: 1;
    margin-bottom: 1;
    overflow: hidden;
}

#presets .extra-label {
    width: 10;
}

#presets Button {
    margin-right: 1;
}

#dialog .preset-chip.-active {
    background: $primary;
    color: $background;
    text-style: bold;
}

#dialog .preset-save {
    background: $background;
    color: $text-muted;
}

/* Clip: Start and End side by side, the timeline button under them. */
.clip-fields {
    height: 2;
    margin-top: 1;
}

.clip-fields Vertical {
    width: 1fr;
    height: 2;
}

.clip-fields Vertical:first-of-type {
    margin-right: 2;
}

.clip-label {
    color: $text-muted;
}

#clip-start, #clip-end {
    width: 100%;
}

#dialog .panel-button {
    width: 100%;
    margin-top: 1;
}

#clip-hint, #clip-note, #extras-note {
    height: auto;
    margin-top: 1;
}

/* Extras: labels on the left, values in one column on the right. */
.extra-line {
    height: 1;
    margin-top: 1;
}

.extra-line:first-of-type {
    margin-top: 1;
}

#extras-panel .extra-line {
    margin-top: 0;
}

#extras-panel {
    padding-top: 1;
}

.extra-label {
    width: 1fr;
    color: $text-muted;
}

#extras-panel Input {
    width: 22;
    background: $background;
}

#extras-panel Input:hover {
    background: $panel;
}

#extras-panel Input:focus {
    background: $primary 25%;
}

#extras-panel #max-kb {
    width: 18;
}

.extra-unit {
    width: 4;
    color: $text-muted;
    text-align: right;
}

/* ---------- clip picker ---------- */

#clip-frame-panel {
    height: 20;
}

#clip-frame {
    width: 100%;
    height: 1fr;
}

#clip-ends {
    height: 1;
    margin-top: 1;
}

#clip-zero, #clip-total {
    width: 1fr;
    color: $text-muted;
}

#clip-total {
    text-align: right;
}

#clip-range {
    height: 1;
    margin-top: 1;
}

#clip-help {
    height: 1;
    margin-top: 1;
}

/* ---------- settings ---------- */

.field-label {
    color: $text-muted;
    margin-top: 1;
}

#folder-row {
    height: 1;
}

#folder {
    width: 1fr;
}

#browse {
    margin-left: 1;
}

#tree {
    height: 12;
    margin-top: 1;
}

#folder-error {
    height: auto;
}

#template {
    width: 100%;
}

#template-preview {
    height: auto;
    margin-top: 1;
}

.settings-row {
    height: 1;
    margin-top: 1;
}

.settings-row .extra-label {
    width: 18;
}

.settings-row Select {
    width: 26;
}

#dialog.settings Checkbox {
    width: auto;
    margin-top: 1;
}

#cookies {
    width: 40;
}

#cookies-note {
    margin: 1 0;
}

#browsers {
    height: auto;
    max-height: 10;
    margin: 1 0;
}

/* ---------- save preset ---------- */

#preset-what {
    margin-bottom: 1;
}

.preset-label {
    width: 8;
    color: $text-muted;
}

#preset-name {
    width: 1fr;
}

.preset-note {
    margin: 1 0 0 8;
}

#preset-error {
    height: auto;
}

/* ---------- sites ---------- */

#site-result {
    height: 1;
    margin: 1 0;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#sites {
    height: 1fr;
}

/* ---------- playlist, history, following, search ---------- */

#entries, #history, #following, #search-hits {
    height: 1fr;
    margin-top: 1;
}

#latest-row {
    height: 1;
    margin-top: 1;
}

#latest-row .extra-label {
    width: 16;
}

#latest {
    width: 10;
}

.extra-hint {
    width: 1fr;
    margin-left: 2;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#picked {
    height: 1;
    margin-top: 1;
}

#history-help, #following-help, #search-help {
    margin-top: 1;
}

#history-empty, #following-empty {
    height: 1fr;
    margin-top: 1;
}

#search-panes {
    height: 1fr;
}

#search-hits {
    width: 1fr;
}

#search-context {
    width: 1fr;
    height: 1fr;
    margin: 1 0 0 2;
    padding: 0 2;
    border: round $panel;
    border-title-color: $text-muted;
}

#search-status {
    height: 1;
    margin-top: 1;
}

/* ---------- lists, tabs, selects: grey at rest, one solid accent chip on focus ---------- */

OptionList {
    border: solid $panel;
    background: $background;
    scrollbar-size-vertical: 1;
    scrollbar-background: $background;
    scrollbar-background-hover: $background;
    scrollbar-background-active: $background;
    scrollbar-color: $panel;
    scrollbar-color-hover: $primary;
    scrollbar-color-active: $primary;
    scrollbar-corner-color: $background;
}

OptionList:focus {
    border: solid $primary;
    background-tint: $foreground 0%;
}

OptionList > .option-list--option-highlighted {
    color: $foreground;
    background: $panel;
    text-style: bold;
}

OptionList:focus > .option-list--option-highlighted {
    color: $background;
    background: $primary;
    text-style: bold;
}

OptionList > .option-list--option-hover {
    background: $panel;
}

Tabs Tab {
    color: $text-muted;
    background: $background;
}

Tabs Tab.-active {
    color: $primary;
    text-style: bold;
}

Tabs:focus Tab.-active {
    color: $background;
    background: $primary;
}

Tabs Underline > .underline--bar {
    color: $primary;
    background: $panel;
}

Select > SelectCurrent {
    border: solid $panel;
    background: $background;
}

Select:focus > SelectCurrent {
    border: solid $primary;
    background-tint: $foreground 0%;
}

Select > SelectOverlay {
    border: round $primary;
}
